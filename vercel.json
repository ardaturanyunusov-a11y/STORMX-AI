export default async function handler(req, res) {
    if (req.method !== 'POST') {
        return res.status(405).json({ error: 'Method not allowed' });
    }

    try {
        const { text } = req.body;
        const apiKey = process.env.GEMINI_API_KEY; // Vercel-ə qoyduğun gizli açarı oxuyur

        const geminiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;
        
        const apiResponse = await fetch(geminiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                contents: [{
                    parts: [{ text: "Sən BUTA AI adlı qabaqcıl neyron intellekt sistemisən. Qısa, səliqəli və texniki dildə cavab ver. İstifadəçi deyir: " + text }]
                }]
            })
        });

        const data = await apiResponse.json();
        return res.status(200).json(data);
    } catch (error) {
        return res.status(500).json({ error: 'Server xətası' });
    }
}
